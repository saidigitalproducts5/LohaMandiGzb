<svg width="1200" height="300" viewBox="0 0 1200 300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0f1a2b"/>
      <stop offset="100%" stop-color="#1b2a57"/>
    </linearGradient>
    <linearGradient id="glow" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#4ee6d6" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#4ee6d6" stop-opacity="0.0"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="300" fill="url(#grad)"/>

  <!-- Left logo placeholder area (320px wide) -->
  <g transform="translate(20,40)">
    <rect x="0" y="0" width="300" height="220" rx="18" ry="18" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.25)" stroke-width="2"/>
    <text x="150" y="110" text-anchor="middle" fill="white" font-family="Inter, system-ui" font-size="28" font-weight="bold">
      LOGO
    </text>
  </g>

  <!-- Right content: site name and tagline -->
  <g transform="translate(340,60)">
    <text x="0" y="40" fill="white" font-family="Inter, system-ui" font-weight="800" font-size="48">
      LOHAM ANDIGZB
    </text>
    <text x="0" y="82" fill="white" font-family="Inter, system-ui" font-weight="400" font-size="22" opacity="0.95">
      Your catchy tagline here
    </text>
  </g>

  <!-- Subtle accent stripe on the bottom edge -->
  <rect x="0" y="280" width="1200" height="20" fill="url(#glow)" opacity="0.5"/>
</svg>